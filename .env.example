# RevivalOS environment
# The app runs FULLY in MOCK MODE with zero external keys.
# Copy this file to .env (already done for local dev).

# --- Database (SQLite, local file) ---
DATABASE_URL="file:./dev.db"

# --- AI provider: "mock" (default, offline & deterministic) or "openai" ---
AI_PROVIDER=mock
OPENAI_API_KEY=

# --- Payments provider: "mock" (default, fixtures) or "razorpay" ---
PAYMENTS_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Auth: secret used to sign the session cookie (change in production) ---
AUTH_SECRET=revivalos-dev-secret-change-me

# --- AI helper (the "Ask RevivalOS" orb): Google Gemini ---
# Leave blank to use the built-in offline guide. Paste a key to enable Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
