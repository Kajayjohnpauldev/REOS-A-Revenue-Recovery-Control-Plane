# RevivalOS environment (local) — MOCK MODE, no external keys required.

# --- Database (SQLite, local file) ---
DATABASE_URL="file:./dev.db"

# --- AI provider: "mock" (default, offline & deterministic) or "openai" ---
AI_PROVIDER=mock
OPENAI_API_KEY=

# --- Payments provider: "mock" (default, fixtures) or "razorpay" ---
PAYMENTS_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Auth: secret used to sign the session cookie ---
AUTH_SECRET=revivalos-dev-secret-change-me

# --- AI helper (Ask RevivalOS orb): Google Gemini ---
# Paste your key here to enable Gemini; blank uses the offline guide.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
